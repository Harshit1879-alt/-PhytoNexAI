<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←  Preview Leaf"
            android:textColor="@color/green_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingVertical="12dp"
            android:contentDescription="Preview Leaf screen" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Check your image before analysis."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Image Preview Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/card_background"
            android:elevation="3dp">

            <ImageView
                android:id="@+id/ivLeafPreview"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:scaleType="fitCenter"
                android:background="@color/green_light"
                android:contentDescription="Selected mango leaf image" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Selected Mango Leaf"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Choose Another Image -->
        <Button
            android:id="@+id/btnChangeImage"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/green_light"
            android:text="Choose Another Image"
            android:textColor="@color/green_dark"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <!-- Direct Camera Capture -->
        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/green_light"
            android:text="Capture Leaf with Camera"
            android:textColor="@color/green_dark"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <!-- Analyze Leaf -->
        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/green_primary"
            android:text="Analyze Leaf"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Persistent Analysis Result -->
        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:elevation="3dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analysis Result"
                android:textColor="@color/green_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="For best results, use a clear image of one mango leaf."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
